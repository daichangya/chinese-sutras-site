      <pb n="0001"/>
      <lb n="a01"/>
      <p xml:id="pT01p0001a0101">如是我聞。</p>
      <lb n="a02"/>
      <p xml:id="pT01p0001a0201">一時佛在舍衛國。</p>
      <lb n="a09"/>
      <p xml:id="pT01p0001a0901">佛告諸比丘：</p>
      <lb n="a12"/>
      <p xml:id="pT01p0001a1201">若有善男子善女人。</p>
