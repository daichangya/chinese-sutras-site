DATA_DIR=./data
# 语料 MD 根目录（低内存 / slim 主库阅读正文必填）
# CORPUS_DIR=./chinese-sutras-md
# 低内存 VPS 部署：slim 主库 + 语料按需 + 受限 SQLite/语料缓存
# JX_LOW_MEMORY=1
# JX_SQLITE_CACHE_MB=32
# JX_CORPUS_CACHE_SUTRAS=3
# 可选：佛光大辭典 MDict 源文件路径（dict:import:mdict）
# FOGUANG_MDX_PATH=./佛光大辭典/佛光大辭典增訂版[阿彌陀佛]20230501.mdx
# FOGUANG_MDD_PATH=./佛光大辭典/佛光大辭典增訂版[阿彌陀佛]20230501.mdd
# 可选：MDict 导入用的 Python（conda 环境，需已 pip install mdict-utils）
# DICT_MDICT_PYTHON=/Users/you/anaconda3/envs/tools/bin/python
# 可选：MapTiler 底图（/places 佛教地理）
NEXT_PUBLIC_MAPTILER_KEY=
AI_GATEWAY_URL=https://your-gateway/v1/chat/completions
AI_GATEWAY_API_KEY=
AI_MODEL=deepseek-chat
CBETA_XML_DIR=./vendor/xml-p5
