DATA_DIR=./data
# 语料 MD 根目录（低内存 / slim 主库阅读正文必填）
# CORPUS_DIR=./chinese-sutras-md
# 低内存 VPS 部署：slim 主库 + 语料按需 + 受限 SQLite/语料缓存
# JX_LOW_MEMORY=1
# JX_SQLITE_CACHE_MB=32
# JX_CORPUS_CACHE_SUTRAS=3
# 可选：佛光大辭典 MDict 源文件路径（dict:import:mdict）
# FOGUANG_MDX_PATH=./佛光大辭典/佛光大辭典增訂版[阿彌陀佛]20230501.mdx
# FOGUANG_MDD_PATH=./佛光大辭典/佛光大辭典增訂版[阿彌陀佛]20230501.mdd
# 可选：MDict 导入用的 Python（conda 环境，需已 pip install mdict-utils）
# DICT_MDICT_PYTHON=/Users/you/anaconda3/envs/tools/bin/python
# 可选：MapTiler 底图（/places 佛教地理）
NEXT_PUBLIC_MAPTILER_KEY=
AI_GATEWAY_URL=https://your-gateway/v1/chat/completions
AI_GATEWAY_API_KEY=
AI_MODEL=deepseek-chat
CBETA_XML_DIR=./vendor/xml-p5

# --- 站点品牌（可选；默认见 lib/site-config.ts：正信•经藏）---
# SITE_BRAND_NAME=正信•经藏
# SITE_BRAND_SLUG=zhengxin-jingzang
# SITE_BRAND_TAGLINE=让佛经更容易读懂
# SITE_BRAND_ICON_CHAR=正
# NEXT_PUBLIC_SITE_BRAND_NAME=正信•经藏

# 微信登录总开关（默认关闭；配置好 AppID 后设为 1 开放入口）
# NEXT_PUBLIC_WECHAT_LOGIN_ENABLED=1

# --- 微信登录（可选；账号数据写入 DATA_DIR/jingxin-auth.db，与语料主库分离）---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
AUTH_SESSION_SECRET=dev-change-me-to-random-32-bytes-minimum
AUTH_SESSION_TTL_DAYS=30
WECHAT_OPEN_APP_ID=
WECHAT_OPEN_APP_SECRET=
WECHAT_MP_APP_ID=
WECHAT_MP_APP_SECRET=
NEXT_PUBLIC_WECHAT_OPEN_APP_ID=
# 开发/测试 Mock 登录（生产勿启用）
# AUTH_MOCK_WECHAT=1
